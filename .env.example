SECRET_KEY=troque-esta-chave
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://USUARIO@localhost:5432/integrasi
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=integrasi@ufsm.br

# Producao (spec 13). As tres nascem ligadas quando DEBUG=False; estao aqui para
# ficar explicitas no servidor, nao porque o padrao dependa delas.
# USAR_X_ACCEL: quem transmite o arquivo e o nginx, nao o worker Python.
USAR_X_ACCEL=True
# CONFIAR_NO_PROXY: ha nginx na frente e o X-Forwarded-For dele vale. Deixe
# False se o gunicorn estiver exposto direto na rede -- ai o cabecalho e do
# cliente, e o limite por IP do formulario publico seria burlavel.
CONFIAR_NO_PROXY=True
# SEGURANCA_HTTPS: redirecionamento para https, cookies Secure e HSTS de um ano.
SEGURANCA_HTTPS=True

# Log da aplicacao e aviso de erro.
#
# CAMINHO_DO_LOG: sem ele nao ha log de arquivo, e um 500 so deixa rastro no
# stderr do gunicorn (journald). O diretorio precisa existir e pertencer ao
# usuario do servico ANTES do primeiro start: o handler e aberto na carga das
# settings, e um caminho impossivel impede o processo de subir.
CAMINHO_DO_LOG=/var/log/integrasi/app.log
# ADMINS: quem recebe e-mail a cada erro 500, no formato "Nome:email", separados
# por virgula. Vazio, ninguem e avisado.
ADMINS=Operacao:integrasi-ops@ufsm.br
# SERVER_EMAIL: remetente desses avisos. O padrao e o DEFAULT_FROM_EMAIL.
SERVER_EMAIL=integrasi@ufsm.br
