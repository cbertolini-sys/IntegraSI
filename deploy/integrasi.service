[Unit]
Description=IntegraSI
After=network.target postgresql.service

[Service]
User=integrasi
Group=www-data
WorkingDirectory=/srv/integrasi
EnvironmentFile=/srv/integrasi/.env
# --timeout acompanha o proxy_read_timeout do nginx: um bloco de 5 MB numa
# conexao ruim leva minutos, e o worker nao pode ser morto antes de o proxy
# desistir -- o usuario veria 502 no meio do upload.
ExecStart=/srv/integrasi/.venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8000 --workers 3 --timeout 300
Restart=always

[Install]
WantedBy=multi-user.target
