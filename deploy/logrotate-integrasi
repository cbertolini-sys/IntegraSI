# Rotacao dos logs do IntegraSI.
# Instalar com: sudo install -o root -g root -m 644 deploy/logrotate-integrasi \
#                       /etc/logrotate.d/integrasi
# (o logrotate RECUSA arquivo de configuracao que nao seja do root, em silencio
# se voce nao ler a saida: "Ignoring ... because the file owner is wrong")
#
# Os dois arquivos estao listados um a um, e NAO como `*.log`, de proposito.
#
# O `app.log` fica de fora porque ja rotaciona sozinho, pelo RotatingFileHandler
# que `config/settings.py` liga quando CAMINHO_DO_LOG existe (10 MB, 10 arquivos).
# Pior: incluir aqui QUEBRARIA aquele log. O gunicorn mantem o arquivo aberto, e o
# logrotate rotaciona renomeando; o processo continua escrevendo no arquivo
# renomeado, e o `app.log` novo nasce vazio e fica vazio ate o proximo reinicio.
# Isso foi visto rodando `logrotate -f -d`, que simula sem escrever, depois de a
# primeira versao deste arquivo ter usado curinga.
#
# `cron.log` e `backup.log` sao escritos pelo `>>` das linhas do crontab, e ali
# renomear funciona: cada execucao do cron abre o arquivo de novo, entao a proxima
# ja escreve no novo. E `>>` nao tem teto, que e o problema que este arquivo
# resolve - a rotina de notificacoes passa a cada minuto, entao sao 1440 linhas
# por dia mesmo com a fila vazia.
#
# Log novo que venha a existir precisa de uma decisao: se quem escreve mantem o
# arquivo aberto, ele nao entra aqui sem `copytruncate` ou sem um `postrotate` que
# mande o processo reabrir.
# O `acesso.log` do gunicorn entra aqui, mas com uma diferenca importante: ele e
# o unico da lista que o processo mantem ABERTO. Renomear sem avisar faria o
# gunicorn continuar escrevendo no arquivo renomeado e o novo nascer vazio - o
# mesmo defeito que tirou o `app.log` desta rotacao. La a solucao foi excluir,
# porque o RotatingFileHandler do Django ja rotaciona sozinho; aqui e reabrir,
# porque o gunicorn sabe fazer isso ao receber SIGUSR1. Ver o `postrotate`.
/var/log/integrasi/cron.log
/var/log/integrasi/backup.log
/var/log/integrasi/acesso.log {
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    # O dono e o `integrasi`, e nao o root: quem escreve nesses arquivos e o cron
    # dele. Sem esta linha o arquivo novo nasce do root e as rotinas param de
    # conseguir escrever, em silencio, na primeira rotacao.
    create 0664 integrasi integrasi
    su integrasi integrasi
    # `sharedscripts` para o bloco rodar UMA vez, e nao uma por arquivo: sao tres
    # padroes aqui e o sinal so precisa ir uma vez.
    sharedscripts
    postrotate
        # SIGUSR1 faz o gunicorn reabrir os arquivos de log. `|| true` porque o
        # servico pode estar parado no momento da rotacao, e uma rotacao que falha
        # por isso interromperia a dos outros arquivos.
        systemctl kill -s USR1 integrasi.service || true
    endscript
}
